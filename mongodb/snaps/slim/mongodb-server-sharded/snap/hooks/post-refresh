#!/usr/bin/env bash
# Refresh hook for mongodb-server-sharded snap

set -eux

export ETC="${SNAP_DATA}"/etc
export CONF="${ETC}"/mongod
export MONGO_CONFIG_FILE="${CONF}"/mongod.conf
export MONGOS_CONFIG_FILE="${CONF}"/mongos.conf
export KEYFILE="${ETC}"/mongodb-keyfile

update_keyfile_path() {
    local config_file="$1"

    if [ "$(id -u)" = "0" ]; then
        "${SNAP}/usr/bin/setpriv" \
            --clear-groups \
            --reuid snap_daemon \
            --regid snap_daemon \
            -- \
            yq -i ".security.keyFile = \"${KEYFILE}\"" "${config_file}"
    else
        yq -i ".security.keyFile = \"${KEYFILE}\"" "${config_file}"
    fi
}

if [ -f "${MONGO_CONFIG_FILE}" ]; then
    update_keyfile_path "${MONGO_CONFIG_FILE}"
fi

if [ -f "${MONGOS_CONFIG_FILE}" ]; then
    update_keyfile_path "${MONGOS_CONFIG_FILE}"
fi
