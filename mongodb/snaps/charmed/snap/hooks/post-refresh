#!/usr/bin/env bash
# post-refresh hook for charmed-mongodb snap

set -eux

export PYTHONPATH="${SNAP}"/usr/lib/python3/dist-packages/
export CONF="${SNAP_DATA}/etc/mongod"
export LOGS_DIR="${SNAP_COMMON}/var/log"
export VAULT_CONF="${SNAP_DATA}/etc/vault"
export PBM_CONF="${SNAP_DATA}/etc/pbm"
export ETC="${SNAP_DATA}/etc/"
export MONGOS_CONFIG_FILE="${CONF}/mongos.conf"
export LOGS="${SNAP_COMMON}/var/log/mongodb"
export VAULT_LOGS="${SNAP_COMMON}/var/log/vault"
export PBM_LOGS="${SNAP_COMMON}/var/log/pbm"
export LDAP_CONF_DIR="${SNAP_DATA}/etc/ldap/"
export VAULT_CONFIG_FILE="${VAULT_CONF}/agent-config.hcl"
export GSS="${SNAP_DATA}/etc/gss"
export HOME_DIR="${SNAP_DATA}/home"
export PBM_CONFIG_FILE="${PBM_CONF}/pbm-agent.yaml"

if [ ! -f $MONGOS_CONFIG_FILE ]; then
    # Copy over the mongos.conf and create needed directories/files
    echo "mongos configuration file does not exist."
    echo "copying default config to ${MONGOS_CONFIG_FILE}"

    # Grant permissions on $CONF
    chown root:snap_daemon "$CONF"

    cp "${SNAP}/etc/mongod.conf" "${MONGOS_CONFIG_FILE}"

    # mongos.conf default values are not consistent with the snap directory system.
    yq -i -Y ".processManagement.fork = false" ${MONGOS_CONFIG_FILE}
    yq -i -Y ".systemLog.path = \"${LOGS}/mongod.log\"" ${MONGOS_CONFIG_FILE}
    yq -i -Y ".net.port = 27018" ${MONGOS_CONFIG_FILE}
    yq -i -Y "del(.storage)" ${MONGOS_CONFIG_FILE}

    # Change ownership of snap directories to allow snap_daemon to read/write
    chown -R 584788:root "${CONF}"
fi

if  [ ! -d $LDAP_CONF_DIR ]; then
    # Copy over the LDAP configuration
    echo "ldap configuration does not exist."
    echo "copying default config to ${LDAP_CONF_DIR}."

    # Grant enough permissions to create files
    chown root:snap_daemon "$ETC"

    cp -r "${SNAP}/etc/ldap/" "${ETC}"

    # Change ownership of snap directories to allow snap_daemon to read/write
    chown -R 584788:root "${ETC}"
fi

if [ ! -d $VAULT_CONF ]; then
    # Copy over the vault configuration
    echo "vault configuration does not exist."
    echo "copying default config to ${VAULT_CONF}."

    # Grant enough permissions to create files
    chown root:snap_daemon "$ETC"

    mkdir -p $VAULT_CONF
    cp -r "${SNAP}/vault.hcl" "${VAULT_CONFIG_FILE}"

    # Change ownership of snap directories to allow snap_daemon to read/write
    chown -R 584788:root "${ETC}"
fi

# Existing installations do not get the GSS directory from the install hook,
# so create and initialize it when they refresh to this revision.
if [ ! -f "${GSS}/mech" ]; then
    # Grant enough permissions to create files
    chown root:snap_daemon "$ETC"
    mkdir -p "${GSS}"

    # Handle ownership to snap_daemon
    chown snap_daemon:snap_daemon ${GSS}
    "${SNAP}/usr/bin/setpriv" \
        --clear-groups \
        --reuid snap_daemon \
        --regid snap_daemon \
        -- \
        bash -euo pipefail -c 'chmod 755 "$1"; touch "$1/mech"; chmod 644 "$1/mech"' bash "${GSS}"

    # Change ownership of snap directories to allow snap_daemon to read/write
    chown -R 584788:root "${ETC}"
fi

if [ ! -f "$PBM_CONFIG_FILE"]; then
    # Grant enough permissions to create files
    chown root:snap_daemon "$ETC"
    mkdir -p "${PBM_CONF}"

    echo "{\"log\": {\"path\": \"${PBM_LOGS}/pbm-agent.json\", \"level\": \"I\", \"json\": true}}" | yq -y | tee ${PBM_CONFIG_FILE}


    # Change ownership of snap directories to allow snap_daemon to read/write
    chown -R 584788:root "${ETC}"
fi

# Create the snap_daemon home directories for installations upgrading from a
# revision that predates them.

# First ensure the directory exists.
if [ ! -d ${HOME_DIR} ]; then
    mkdir -p ${HOME_DIR}
fi

# Second ensure root ownership
chown root:snap_daemon "${HOME_DIR}"
chown root:snap_daemon "${LOGS_DIR}"

DIRECTORIES=("${HOME_DIR}/.cache" "${HOME_DIR}/.config" "${HOME_DIR}/.mongodb/mongosh" "${PBM_LOGS}") 

# Third create all directories.
for directory in ${DIRECTORIES[@]}; do
    if [ ! -d "$directory" ]; then
        mkdir -p "$directory"
        chown 584788:root ${directory}
    fi
done

chown 584788:root ${HOME_DIR}
chown 584788:root ${LOGS_DIR}
