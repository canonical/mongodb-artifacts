#!/bin/bash
set -eu

HOME_DIR="${SNAP_DATA}/home"
GSS="${SNAP_DATA}/etc/gss"
mkdir -p "${GSS}"
chown 584788:root "${GSS}"
"${SNAP}/usr/bin/setpriv" \
    --clear-groups \
    --reuid snap_daemon \
    --regid snap_daemon \
    -- \
    bash -euo pipefail -c 'chmod 755 "$1"; touch "$1/mech"; chmod 644 "$1/mech"' bash "${GSS}"

export HOME_DIR="${SNAP_DATA}/home"
# First ensure the directory exists.
if [ ! -d ${HOME_DIR} ]; then
    mkdir -p ${HOME_DIR}
fi

# Second ensure root ownership
chown root:snap_daemon "${HOME_DIR}"

DIRECTORIES=("${HOME_DIR}/.cache" "${HOME_DIR}/.config")

# Third create all directories.
for directory in ${DIRECTORIES[@]}; do
    if [ ! -d "$directory" ]; then
        mkdir -p "$directory"
        chown 584788:root ${directory}
    fi
done

chown 584788:root ${HOME_DIR}

"${SNAP}/usr/bin/setpriv" \
    --clear-groups \
    --reuid snap_daemon \
    --regid snap_daemon \
    -- \
    mkdir -p "${HOME_DIR}/.mongodb/mongosh"

exit 0

